# Copy this file to .env and set your project ID:
#   cp .env.example .env
# The README also shows a one-line command that writes .env for you.

# Your Google Cloud project ID (not the project name).
GOOGLE_CLOUD_PROJECT=your-project-id

# Keep "global". The agent's model, gemini-3.8-flash, is served from the global endpoint.
GOOGLE_CLOUD_LOCATION=global

# Call Gemini through Vertex AI in your project, with your Google Cloud credentials.
GOOGLE_GENAI_USE_ENTERPRISE=True
